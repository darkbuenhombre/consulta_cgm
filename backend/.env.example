# Puerto donde escucha la API
PORT=4000

# Conexión a PostgreSQL: postgres://usuario:clave@host:puerto/base_de_datos
# En Linux, sin clave y por socket local: postgres:///consulta?host=/var/run/postgresql
# (sin "?host=" la librería pg usa TCP y exige contraseña)
DATABASE_URL=postgres://usuario:clave@localhost:5432/consulta

# Texto largo y aleatorio para firmar los tokens de login.
# Puedes generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Cuenta de Gmail que envía los correos y su "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). Si se dejan vacías, los correos
# no se envían y solo se muestran en la consola.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Dirección del frontend (para CORS y para el enlace de cancelación)
FRONTEND_URL=http://localhost:3000

# Base de datos SOLO para los tests (npm test la borra cada vez). Si se deja
# vacía, se saltan los tests de la API.
TEST_DATABASE_URL=postgres://usuario:clave@localhost:5432/consulta_test
